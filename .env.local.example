# Copy this file to .env.local if you want a dev-time default API URL other
# than the Vite proxy below. .env.local is gitignored — never commit real
# values.
#
# Firebase Authentication config used to live here too (VITE_FIREBASE_*) —
# it's gone: the app now asks the backend for it at runtime
# (GET /api/config/public, see src/config/serverConfig.ts,
# views/ServerSetupView.vue) instead of carrying a build-time Firebase
# project baked into the bundle. Nothing to fill in here for that anymore.

# Base URL of the backend (src/api/http.ts), used ONLY until this browser
# has gone through ServerSetupView and picked a server (persisted to
# localStorage from then on). In dev this is proxied by Vite (see
# server.proxy in vite.config.ts) so it can stay relative.
VITE_API_URL=/api
